# Copier vers .env (ignoré par git) puis remplir — jamais committer .env
NEXT_PUBLIC_GITHUB_OWNER=hdmanoach
NEXT_PUBLIC_GITHUB_REPO=manoach-portfolio
NEXT_PUBLIC_SITE_URL=https://manoach-portfolio.vercel.app

# Token GitHub fine-grained sur ce dépôt (Contents: read & write) — requis par
# `npm run curate` pour valider et pousser data/projects.json. Jamais de NEXT_PUBLIC_*
GITHUB_TOKEN=
